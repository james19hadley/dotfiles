#!/usr/bin/env bash
# Fast CLI wrapper to synthesize speech using local ADA VITS ONNX model + DSP
set -euo pipefail

TEXT="${1:-}"
OUTPUT="${2:-/tmp/ada_output.wav}"

if [[ -z "$TEXT" ]]; then
  echo "Usage: ada-tts \"Text to speak\" [output.wav]" >&2
  exit 1
fi

cd /home/ging/prog/ada
uv run python -c '
import sys
from pathlib import Path
from ada.config import load_config
from ada.audio.tts import LocalPiperTTS
from ada.audio.dsp import AudioDSP

text = sys.argv[1]
output_path = Path(sys.argv[2])

cfg = load_config()
cfg.audio.provider = "local"
tts = LocalPiperTTS(cfg.audio)

raw_tmp = output_path.with_suffix(".raw.wav")
res = tts.synthesize(text, raw_tmp)

if res and raw_tmp.exists():
    if cfg.audio.dsp.enabled:
        dsp = AudioDSP(cfg.audio.dsp)
        dsp.apply_ada_effects(raw_tmp, output_path, play_chime=False)
        if raw_tmp != output_path and raw_tmp.exists():
            raw_tmp.unlink()
    else:
        raw_tmp.replace(output_path)
' "$TEXT" "$OUTPUT"
