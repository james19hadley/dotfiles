#!/bin/bash

# Apply display profile (external_only | extend | mirror_external | mirror_laptop | laptop_only | reset)
# 100% universal for any monitor (HDMI, DP, Type-C, etc.) and any resolution/refresh rate

set -euo pipefail

PROFILE="${1:-}"
PROFILE_FILE="$HOME/.config/omarchy/display_profile"

mkdir -p "$HOME/.config/omarchy" "$HOME/.local/state/omarchy/toggles/hypr"
[[ -f "$HOME/.local/state/omarchy/toggles/hypr/flags.conf" ]] || echo "# Permanent flag" > "$HOME/.local/state/omarchy/toggles/hypr/flags.conf"

if [[ -z "$PROFILE" ]]; then
  if [[ -f "$PROFILE_FILE" ]]; then
    PROFILE=$(<"$PROFILE_FILE")
  else
    PROFILE="external_only"
  fi
fi

# Detect internal monitor (eDP / LVDS / DSI)
INTERNAL=$(hyprctl monitors all -j 2>/dev/null | jq -r '.[] | select(.name | test("eDP|LVDS|DSI")).name' | head -n 1 || echo "")
[[ -z "$INTERNAL" ]] && INTERNAL="eDP-1"

# Detect any external monitor dynamically (HDMI, DP, USB-C)
EXTERNAL=$(hyprctl monitors all -j 2>/dev/null | jq -r '.[] | select(.name | test("eDP|LVDS|DSI") | not).name' | head -n 1 || echo "")
if [[ -z "$EXTERNAL" ]]; then
  for status in /sys/class/drm/card*-*/status; do
    [[ "$status" =~ -eDP-|-LVDS-|-DSI- ]] && continue
    if [[ -f "$status" && "$(<"$status")" == "connected" ]]; then
      EXTERNAL=$(basename "$(dirname "$status")" | sed -E 's/^card[0-9]+-//')
      break
    fi
  done
fi

has_external() {
  [[ -n "$EXTERNAL" ]]
}

# Automatically extract native resolution & highest refresh rate from monitor EDID chip
get_best_external_mode() {
  local mode
  mode=$(hyprctl monitors all -j 2>/dev/null | jq -r ".[] | select(.name == \"$EXTERNAL\").availableModes[]?" | sort -V | tail -n 1 | sed 's/Hz//' || echo "")
  echo "${mode:-preferred}"
}

move_all_workspaces_to() {
  local target="$1"
  local ws_ids
  ws_ids=$(hyprctl workspaces -j 2>/dev/null | jq -r '.[].id' || echo "1")
  for ws in $ws_ids; do
    hyprctl dispatch moveworkspacetomonitor "$ws" "$target" 2>/dev/null || true
  done
  hyprctl dispatch focusmonitor "$target" 2>/dev/null || true
  hyprctl dispatch workspace 1 2>/dev/null || true
}

case "$PROFILE" in
  external_only)
    if has_external; then
      best_ext_mode=$(get_best_external_mode)
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/external-monitor-disable.conf"
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-mirror.conf"
      echo "monitor=$INTERNAL,disable" > "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-disable.conf"
      hyprctl keyword monitor "$INTERNAL, disable"
      hyprctl keyword monitor "$EXTERNAL, $best_ext_mode, 0x0, 1"
      hyprctl reload 2>/dev/null || true
      sleep 0.1
      move_all_workspaces_to "$EXTERNAL"
      printf "external_only" > "$PROFILE_FILE"
      notify-send -u low "󰍹  Display" "External Screen Only active ($EXTERNAL)"
    else
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-disable.conf"
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/external-monitor-disable.conf"
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-mirror.conf"
      hyprctl keyword monitor "$INTERNAL, preferred, 0x0, 1.25"
      hyprctl reload 2>/dev/null || true
      move_all_workspaces_to "$INTERNAL"
    fi
    ;;

  extend)
    if has_external; then
      best_ext_mode=$(get_best_external_mode)
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/external-monitor-disable.conf"
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-disable.conf"
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-mirror.conf"
      hyprctl keyword monitor "$INTERNAL, preferred, 0x0, 1.25"
      hyprctl keyword monitor "$EXTERNAL, $best_ext_mode, auto-right, 1"
      hyprctl reload 2>/dev/null || true
      hyprctl dispatch focusmonitor "$EXTERNAL" 2>/dev/null || true
      printf "extend" > "$PROFILE_FILE"
      notify-send -u low "󰍹  Display" "Extended display mode active"
    fi
    ;;

  mirror_external|mirror)
    if has_external; then
      best_ext_mode=$(get_best_external_mode)
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/external-monitor-disable.conf"
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-disable.conf"
      # Base: External display (high-res canvas), Laptop mirrors External
      printf "monitor=%s, %s, 0x0, 1\nmonitor=%s, preferred, auto, 1, mirror, %s\n" \
        "$EXTERNAL" "$best_ext_mode" "$INTERNAL" "$EXTERNAL" > "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-mirror.conf"
      hyprctl reload 2>/dev/null || true
      hyprctl dispatch focusmonitor "$EXTERNAL" 2>/dev/null || true
      move_all_workspaces_to "$EXTERNAL"
      printf "mirror_external" > "$PROFILE_FILE"
      notify-send -u low "󰍺  Display" "Mirror Displays active (External Base: $EXTERNAL)"
    fi
    ;;

  mirror_laptop)
    if has_external; then
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/external-monitor-disable.conf"
      rm -f "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-disable.conf"
      # Base: Laptop display (native UI scale), External mirrors Laptop
      printf "monitor=%s, preferred, 0x0, 1\nmonitor=%s, preferred, auto, 1, mirror, %s\n" \
        "$INTERNAL" "$EXTERNAL" "$INTERNAL" > "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-mirror.conf"
      hyprctl reload 2>/dev/null || true
      hyprctl dispatch focusmonitor "$INTERNAL" 2>/dev/null || true
      move_all_workspaces_to "$INTERNAL"
      printf "mirror_laptop" > "$PROFILE_FILE"
      notify-send -u low "󰍺  Display" "Mirror Displays active (Laptop Base: $INTERNAL)"
    fi
    ;;

  laptop_only)
    rm -f "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-disable.conf"
    rm -f "$HOME/.local/state/omarchy/toggles/hypr/internal-monitor-mirror.conf"
    if has_external; then
      echo "monitor=$EXTERNAL,disable" > "$HOME/.local/state/omarchy/toggles/hypr/external-monitor-disable.conf"
      hyprctl keyword monitor "$EXTERNAL, disable"
    fi
    hyprctl keyword monitor "$INTERNAL, preferred, 0x0, 1.25"
    hyprctl reload 2>/dev/null || true
    sleep 0.1
    move_all_workspaces_to "$INTERNAL"
    printf "laptop_only" > "$PROFILE_FILE"
    notify-send -u low "󰌢  Display" "Built-in screen only"
    ;;

  reset)
    rm -f "$HOME/.local/state/omarchy/toggles/hypr/"*monitor*.conf
    echo "# Permanent flag" > "$HOME/.local/state/omarchy/toggles/hypr/flags.conf"
    hyprctl reload
    printf "external_only" > "$PROFILE_FILE"
    notify-send -u low "󰑓  Display" "Reset display settings to default"
    ;;
esac

omarchy-restart-waybar 2>/dev/null || true
