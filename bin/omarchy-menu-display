#!/bin/bash

# Omarchy Interactive Display / Monitor Switcher (Win+P)
# Fast 1-click switching with Windows-style Super+P cycling & persistent settings

set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/omarchy/bin:$PATH"

CYCLE_STATE_FILE="/tmp/omarchy_display_cycle_idx"
MIRROR_BASE_FILE="$HOME/.config/omarchy/mirror_base"

# Handle Windows-style Super+P cycling if menu is already active
handle_cycling_if_open() {
  local num_modes=4
  if pgrep -f "walker.*Display Setup" >/dev/null 2>&1; then
    local cur_idx=0
    [[ -f "$CYCLE_STATE_FILE" ]] && cur_idx=$(<"$CYCLE_STATE_FILE")

    local next_idx=$(( (cur_idx + 1) % num_modes ))
    if (( next_idx == 0 )); then
      wtype -k Up -k Up -k Up 2>/dev/null || true
    else
      wtype -k Down 2>/dev/null || true
    fi
    echo "$next_idx" > "$CYCLE_STATE_FILE"
    exit 0
  fi
}

handle_cycling_if_open

echo "0" > "$CYCLE_STATE_FILE"
trap 'rm -f "$CYCLE_STATE_FILE"' EXIT

ensure_active_monitor_focus() {
  local active_mons
  active_mons=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.disabled == false).name' || echo "")
  local focused_mon
  focused_mon=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused == true).name' | head -n 1 || echo "")

  if [[ -z "$focused_mon" ]] || ! echo "$active_mons" | grep -qw "$focused_mon"; then
    local fallback_mon
    fallback_mon=$(echo "$active_mons" | head -n 1)
    if [[ -n "$fallback_mon" ]]; then
      hyprctl dispatch focusmonitor "$fallback_mon" 2>/dev/null || true
    fi
  fi
}

ensure_active_monitor_focus

detect_live_profile() {
  local json
  json=$(hyprctl monitors all -j 2>/dev/null)
  
  local is_mirrored
  is_mirrored=$(echo "$json" | jq '[.[] | select(.mirrorOf != "none" and .mirrorOf != "" and .disabled == false)] | length')
  local internal_active
  internal_active=$(echo "$json" | jq '[.[] | select((.name | test("eDP|LVDS|DSI")) and .disabled == false)] | length')
  local external_active
  external_active=$(echo "$json" | jq '[.[] | select((.name | test("eDP|LVDS|DSI") | not) and .disabled == false)] | length')

  if (( is_mirrored > 0 )); then
    echo "mirror"
  elif (( internal_active > 0 && external_active > 0 )); then
    echo "extend"
  elif (( internal_active == 0 && external_active > 0 )); then
    echo "external_only"
  elif (( internal_active > 0 && external_active == 0 )); then
    echo "laptop_only"
  else
    echo "external_only"
  fi
}

CURRENT_PROFILE=$(detect_live_profile)

is_laptop() {
  hyprctl monitors all -j 2>/dev/null | jq -e '.[] | select(.name | test("eDP|LVDS|DSI"))' >/dev/null 2>&1
}

has_external() {
  local ext
  ext=$(hyprctl monitors all -j 2>/dev/null | jq -r '.[] | select(.name | test("eDP|LVDS|DSI") | not).name' | head -n 1 || echo "")
  if [[ -n "$ext" ]]; then
    return 0
  fi
  for status in /sys/class/drm/card*-*/status; do
    [[ "$status" =~ -eDP-|-LVDS-|-DSI- ]] && continue
    if [[ -f "$status" && "$(<"$status")" == "connected" ]]; then
      return 0
    fi
  done
  return 1
}

DOT_ACTIVE="●"
DOT_INACTIVE="○"

get_dot() {
  local prof="$1"
  if [[ "$CURRENT_PROFILE" == "$prof" ]]; then
    echo "$DOT_ACTIVE"
  else
    echo "$DOT_INACTIVE"
  fi
}

build_options() {
  local d_ext d_extnd d_mirr d_prim
  d_ext=$(get_dot "external_only")
  d_extnd=$(get_dot "extend")
  d_mirr=$(get_dot "mirror")
  d_prim=$(get_dot "laptop_only")

  local item_ext item_prim
  if is_laptop; then
    item_ext="${d_ext} 󰍹 󰛧  External Screen Only "
    item_prim="${d_prim} 󰌢   Built-in Screen Only "
  else
    item_ext="${d_ext} 󰍹   Secondary Display Only "
    item_prim="${d_prim} 󰍹   Primary Display Only "
  fi

  local item_extend="${d_extnd} 󰍹 󰍹  Extend Displays "
  local item_mirror="${d_mirr} 󰍺 󰍺  Mirror Displays "
  local item_reset="󰑓  Reset to Default Setup "
  local item_scale="󰍜  Scaling "

  if has_external; then
    printf "%s\n%s\n%s\n%s\n%s\n%s" \
      "$item_ext" \
      "$item_extend" \
      "$item_mirror" \
      "$item_prim" \
      "$item_reset" \
      "$item_scale"
  else
    printf "%s\n%s\n%s" \
      "$item_prim" \
      "$item_reset" \
      "$item_scale"
  fi
}

menu() {
  local prompt="$1"
  local opts="$2"

  if command -v omarchy-launch-walker >/dev/null 2>&1; then
    echo -e "$opts" | omarchy-launch-walker --dmenu --width 370 --minheight 1 --maxheight 400 -p "$prompt…" 2>/dev/null || true
  elif command -v walker >/dev/null 2>&1; then
    echo -e "$opts" | walker --dmenu --width 370 -p "$prompt…" 2>/dev/null || true
  elif command -v rofi >/dev/null 2>&1; then
    echo -e "$opts" | rofi -dmenu -p "$prompt" 2>/dev/null || true
  else
    echo -e "$opts" | head -n 1
  fi
}

select_scaling() {
  local cur_mirror="laptop"
  [[ -f "$MIRROR_BASE_FILE" ]] && cur_mirror=$(<"$MIRROR_BASE_FILE")

  local active_mons
  active_mons=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.disabled == false).name' || echo "")
  local mon_count
  mon_count=$(echo "$active_mons" | wc -w)

  local target_mon=""
  if (( mon_count > 1 )); then
    local target_opts=""
    for m in $active_mons; do
      local cur_sc
      cur_sc=$(hyprctl monitors -j | jq -r ".[] | select(.name == \"$m\").scale // 1")
      if [[ "$m" =~ eDP|LVDS|DSI ]]; then
        target_opts+="󰌢  Laptop Screen ($m — ${cur_sc}x) \n"
      else
        target_opts+="󰍹  External Display ($m — ${cur_sc}x) \n"
      fi
    done
    target_opts+="󰍺  Mirror Base: [$cur_mirror] (Click to change) "
    
    local mon_choice
    mon_choice=$(menu "Scaling & Preferences" "$target_opts")
    [[ -z "$mon_choice" ]] && return 0

    if [[ "$mon_choice" == *"Mirror Base"* ]]; then
      local m_choice
      m_choice=$(menu "Default Mirror Base" "󰌢  Laptop Screen (1080p native UI) \n󰍹  External Display (1440p high-res) ")
      [[ -z "$m_choice" ]] && return 0
      if [[ "$m_choice" == *"External"* ]]; then
        echo "external" > "$MIRROR_BASE_FILE"
        notify-send -u low "󰍺  Mirror Setting" "Default Mirror Base set to External Display (1440p)"
      else
        echo "laptop" > "$MIRROR_BASE_FILE"
        notify-send -u low "󰍺  Mirror Setting" "Default Mirror Base set to Laptop Screen (1080p)"
      fi
      return 0
    fi

    target_mon=$(echo "$mon_choice" | grep -oE "eDP-[0-9]+|HDMI-A-[0-9]+|DP-[0-9]+" || head -n 1 <<< "$active_mons")
  else
    target_mon=$(echo "$active_mons" | head -n 1)
  fi

  local mon_info
  mon_info=$(hyprctl monitors -j | jq -c ".[] | select(.name == \"$target_mon\")" 2>/dev/null || true)
  local cur_scale width height rr
  cur_scale=$(echo "$mon_info" | jq -r '.scale // 1')
  width=$(echo "$mon_info" | jq -r '.width // 1920')
  height=$(echo "$mon_info" | jq -r '.height // 1080')
  rr=$(echo "$mon_info" | jq -r '.refreshRate // 60')

  local clean_cur="$cur_scale"
  local scales=("1.0" "1.25" "1.4" "1.5" "1.6" "1.75" "2.0" "3.0" "4.0")
  local scale_opts=""
  for s in "${scales[@]}"; do
    if [[ "$clean_cur" == "$s" || "$clean_cur" == "$s.0" || "$clean_cur" == "${s}0" ]]; then
      scale_opts+="${DOT_ACTIVE} 󰍹  ${s}x \n"
    else
      scale_opts+="${DOT_INACTIVE} 󰍹  ${s}x \n"
    fi
  done
  scale_opts+="󰍹  Custom "

  local choice
  choice=$(menu "Scaling for $target_mon (${cur_scale}x)" "$scale_opts")
  [[ -z "$choice" ]] && return 0

  local new_scale=""
  case "$choice" in
    *"1.0x"*) new_scale="1.0" ;;
    *"1.25x"*) new_scale="1.25" ;;
    *"1.4x"*) new_scale="1.4" ;;
    *"1.5x"*) new_scale="1.5" ;;
    *"1.6x"*) new_scale="1.6" ;;
    *"1.75x"*) new_scale="1.75" ;;
    *"2.0x"*) new_scale="2.0" ;;
    *"3.0x"*) new_scale="3.0" ;;
    *"4.0x"*) new_scale="4.0" ;;
    *"Custom"*)
      local custom_input
      if command -v omarchy-menu-input >/dev/null 2>&1; then
        custom_input=$(omarchy-menu-input "Scale (e.g. 1.35)")
      else
        custom_input=$(menu "Scale (e.g. 1.35)" "")
      fi
      [[ -n "$custom_input" ]] && new_scale="$custom_input"
      ;;
    *)
      clean_input=$(echo "$choice" | tr -cd '0-9.')
      if [[ -n "$clean_input" ]]; then
        new_scale="$clean_input"
      fi
      ;;
  esac

  if [[ -z "$new_scale" ]] || [[ ! "$new_scale" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    return 0
  fi

  hyprctl keyword monitor "$target_mon,${width}x${height}@${rr},auto,$new_scale"
  omarchy-restart-waybar 2>/dev/null || true
  notify-send -u low "󰍹  Display" "Scaling set to ${new_scale}x on $target_mon"
}

options=$(build_options)
selected=$(menu "Display Setup" "$options")

[[ -z "$selected" ]] && exit 0

case "$selected" in
  *"External Screen"*|*"Secondary Display"*)
    omarchy-display-apply external_only
    ;;
  *"Extend Displays"*)
    omarchy-display-apply extend
    ;;
  *"Mirror Displays"*)
    omarchy-display-apply mirror
    ;;
  *"Built-in Screen"*|*"Primary Display"*)
    omarchy-display-apply laptop_only
    ;;
  *"Reset to Default Setup"|*"Reset"*)
    omarchy-display-apply reset
    ;;
  *"Scaling"*)
    select_scaling
    ;;
esac
