#!/bin/bash

# Omarchy Interactive Display / Monitor Switcher (Win+P)

set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.local/share/omarchy/bin:$PATH"

PROFILE_FILE="$HOME/.config/omarchy/display_profile"
CURRENT_PROFILE="external_only"
[[ -f "$PROFILE_FILE" ]] && CURRENT_PROFILE=$(<"$PROFILE_FILE")

# Detect internal vs external monitors
is_laptop() {
  hyprctl monitors all -j 2>/dev/null | jq -e '.[] | select(.name | test("eDP|LVDS|DSI"))' >/dev/null 2>&1
}

has_external() {
  local ext
  ext=$(hyprctl monitors all -j 2>/dev/null | jq -r '.[] | select(.name | test("eDP|LVDS|DSI") | not).name' | head -n 1 || echo "")
  if [[ -n "$ext" ]]; then
    return 0
  fi
  for status in /sys/class/drm/card*-*/status; do
    [[ "$status" =~ -eDP-|-LVDS-|-DSI- ]] && continue
    if [[ -f "$status" && "$(<"$status")" == "connected" ]]; then
      return 0
    fi
  done
  return 1
}

# Symmetrical, clear icon design:
# 󰍹 = Monitor On | 󰠹 = Monitor Off
# 󰌢 = Laptop On  | 󰛧 = Laptop Off
if is_laptop; then
  ITEM_EXTERNAL="󰍹 󰛧  External Screen Only"
  ITEM_PRIMARY="󰌢 󰠹  Built-in Screen Only"
else
  ITEM_EXTERNAL="󰍹 󰠹  Secondary Display Only"
  ITEM_PRIMARY="󰍹 󰠹  Primary Display Only"
fi

ITEM_EXTEND="󰍹 󰍹  Extend Displays"
ITEM_MIRROR="󰍹 = 󰍹 Mirror Displays"
ITEM_RESET="󰑓    Reset"
ITEM_SCALING="󰍜    Scaling"

build_options() {
  if has_external; then
    printf "%s\n%s\n%s\n%s\n%s\n%s" \
      "$ITEM_EXTERNAL" \
      "$ITEM_EXTEND" \
      "$ITEM_MIRROR" \
      "$ITEM_PRIMARY" \
      "$ITEM_RESET" \
      "$ITEM_SCALING"
  else
    printf "%s\n%s\n%s" \
      "$ITEM_PRIMARY" \
      "$ITEM_RESET" \
      "$ITEM_SCALING"
  fi
}

get_preselect_item() {
  case "$CURRENT_PROFILE" in
    external_only) echo "$ITEM_EXTERNAL" ;;
    extend) echo "$ITEM_EXTEND" ;;
    mirror) echo "$ITEM_MIRROR" ;;
    laptop_only) echo "$ITEM_PRIMARY" ;;
    *) echo "$ITEM_EXTERNAL" ;;
  esac
}

menu() {
  local prompt="$1"
  local opts="$2"
  local preselect="${3:-}"
  local extra_args=()

  # Walker -c expects 1-based integer line number
  if [[ -n "$preselect" ]]; then
    local index
    index=$(echo -e "$opts" | grep -nxF "$preselect" | cut -d: -f1 || echo "")
    if [[ -n "$index" && "$index" =~ ^[0-9]+$ ]]; then
      extra_args+=("-c" "$index")
    fi
  fi

  if command -v omarchy-launch-walker >/dev/null 2>&1; then
    echo -e "$opts" | omarchy-launch-walker --dmenu --width 340 --minheight 1 --maxheight 400 -p "$prompt…" "${extra_args[@]}" 2>/dev/null || true
  elif command -v walker >/dev/null 2>&1; then
    echo -e "$opts" | walker --dmenu --width 340 -p "$prompt…" "${extra_args[@]}" 2>/dev/null || true
  elif command -v rofi >/dev/null 2>&1; then
    echo -e "$opts" | rofi -dmenu -p "$prompt" 2>/dev/null || true
  else
    echo -e "$opts" | head -n 1
  fi
}

select_scaling() {
  local mon_info
  mon_info=$(hyprctl monitors -j | jq -c '.[] | select(.focused == true)' 2>/dev/null || true)
  if [[ -z "$mon_info" ]] || [[ "$mon_info" == "null" ]]; then
    mon_info=$(hyprctl monitors -j | jq -c '.[0]' 2>/dev/null || true)
  fi

  local active_mon cur_scale width height rr
  active_mon=$(echo "$mon_info" | jq -r '.name // empty')
  cur_scale=$(echo "$mon_info" | jq -r '.scale // 1')
  width=$(echo "$mon_info" | jq -r '.width // 1920')
  height=$(echo "$mon_info" | jq -r '.height // 1080')
  rr=$(echo "$mon_info" | jq -r '.refreshRate // 60')

  local scale_opts="󰍹  1.0x\n󰍹  1.25x\n󰍹  1.4x\n󰍹  1.5x\n󰍹  1.6x\n󰍹  1.75x\n󰍹  2.0x\n󰍹  3.0x\n󰍹  4.0x\n󰍹  Custom"

  local current_match="󰍹  ${cur_scale}x"
  local choice
  choice=$(menu "Scaling (${cur_scale}x)" "$scale_opts" "$current_match")
  [[ -z "$choice" ]] && return 0

  local new_scale=""
  case "$choice" in
    *"1.0x"*) new_scale="1.0" ;;
    *"1.25x"*) new_scale="1.25" ;;
    *"1.4x"*) new_scale="1.4" ;;
    *"1.5x"*) new_scale="1.5" ;;
    *"1.6x"*) new_scale="1.6" ;;
    *"1.75x"*) new_scale="1.75" ;;
    *"2.0x"*) new_scale="2.0" ;;
    *"3.0x"*) new_scale="3.0" ;;
    *"4.0x"*) new_scale="4.0" ;;
    *"Custom"*)
      local custom_input
      if command -v omarchy-menu-input >/dev/null 2>&1; then
        custom_input=$(omarchy-menu-input "Scale (e.g. 1.35)")
      else
        custom_input=$(menu "Scale (e.g. 1.35)" "")
      fi
      [[ -n "$custom_input" ]] && new_scale="$custom_input"
      ;;
    *)
      clean_input=$(echo "$choice" | tr -cd '0-9.')
      if [[ -n "$clean_input" ]]; then
        new_scale="$clean_input"
      fi
      ;;
  esac

  if [[ -z "$new_scale" ]] || [[ ! "$new_scale" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
    return 0
  fi

  hyprctl keyword monitor "$active_mon,${width}x${height}@${rr},auto,$new_scale"
  omarchy-restart-waybar 2>/dev/null || true
  notify-send -u low "󰍹  Display" "Scaling set to ${new_scale}x on $active_mon"
}

options=$(build_options)
preselect=$(get_preselect_item)
selected=$(menu "Display Setup" "$options" "$preselect")

[[ -z "$selected" ]] && exit 0

case "$selected" in
  *"External Screen"|*"Secondary Display"*)
    omarchy-display-apply external_only
    ;;
  *"Extend Displays"*)
    omarchy-display-apply extend
    ;;
  *"Mirror Displays"*)
    omarchy-display-apply mirror
    ;;
  *"Built-in Screen"|*"Primary Display"*)
    omarchy-display-apply laptop_only
    ;;
  *"Reset"*)
    omarchy-display-apply reset
    ;;
  *"Scaling"*)
    select_scaling
    ;;
esac
